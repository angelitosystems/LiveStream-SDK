       doctor, publicación) viven en SdkCore y los comparte con la GUI (LiveStream.SdkStudio). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>lsplugin</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\LiveStream.PluginSdk\LiveStream.PluginSdk.csproj" />
    <ProjectReference Include="..\..\src\LiveStream.SdkCore\LiveStream.SdkCore.csproj" />
  </ItemGroup>
</Project>
